# Backend — PRODUZIONE. Copiare in backend/.env sull'EC2.
# Il backend parla con Supabase INTERNAMENTE (Kong su localhost:8000): più veloce
# e non passa da Caddy. Le chiavi provengono dalla config del self-host.
SUPABASE_URL=http://127.0.0.1:8000
SUPABASE_ANON_KEY=<ANON_KEY del self-host>
SUPABASE_SERVICE_ROLE_KEY=<SERVICE_ROLE_KEY del self-host>
PORT=3000
# Restringe il CORS al solo dominio dell'app
CORS_ORIGIN=https://app.esempio.com
