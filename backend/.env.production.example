# Backend — PRODUZIONE (EC2). Copiare in backend/.env sul server.
# In produzione il DB è Supabase CLOUD (non self-host): i valori si prendono dal
# Supabase Dashboard → Project Settings → API.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=<anon public key dal dashboard>
SUPABASE_SERVICE_ROLE_KEY=<service_role key dal dashboard — SOLO server, mai nel browser>
PORT=3000
# Restringe il CORS al solo host dell'app (lista separata da virgole).
# Senza dominio proprio: https://<IP-con-trattini>.sslip.io (es. 52-30-1-2.sslip.io)
# capacitor://localhost è l'origine della WebView dell'app iOS (Capacitor, iosScheme
# "capacitor"): senza di essa le chiamate /api dall'app iOS falliscono per CORS.
CORS_ORIGIN=https://52-30-1-2.sslip.io,capacitor://localhost
