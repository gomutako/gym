{
  "name": "gym-manager",
  "version": "1.5.0",
  "private": true,
  "description": "Web app mobile-first per la gestione di una palestra (Vue 3 + Supabase)",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace frontend",
    "dev:fe": "npm run dev --workspace frontend",
    "build": "npm run build --workspace frontend",
    "seed": "node scripts/seed.mjs",
    "seed:exercises": "node scripts/seed.mjs --exercises-only",
    "seed:cloud": "node scripts/seed.mjs --cloud",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:reset:seed": "./scripts/reset-db.sh",
    "db:status": "supabase status",
    "db:push": "./scripts/db-push.sh",
    "db:push:dry": "./scripts/db-push.sh --dry-run"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "dotenv": "^16.4.5",
    "supabase": "^2.109.1"
  }
}
