{
  "name": "gym-manager",
  "version": "1.5.0",
  "private": true,
  "description": "Web app mobile-first per la gestione di una palestra (Vue 3 + Fastify + Supabase)",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:fe": "npm run dev --workspace frontend",
    "dev:be": "npm run dev --workspace backend",
    "build": "npm run build --workspace frontend",
    "seed": "node scripts/seed.mjs",
    "seed:exercises": "node scripts/seed.mjs --exercises-only",
    "seed:cloud": "node scripts/seed.mjs --cloud",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:reset:seed": "./scripts/reset-db.sh",
    "db:status": "supabase status",
    "db:push": "./deploy/db-push.sh"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "supabase": "^2.109.1"
  }
}
