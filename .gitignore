# Dipendenze
node_modules/

# Build output
dist/
frontend/dist/

# Variabili d'ambiente (mai committare le chiavi reali!)
.env
.env.*
# Eccezione: contiene solo l'URL del progetto e la chiave publishable, che sono
# già dentro il bundle servito al browser. Versionarlo evita che la build passi
# ma produca un'app bianca, e serve anche alla build dell'app iOS.
!frontend/.env.production
!.env.example
!.env.production.example

# Log
*.log
npm-debug.log*

# Terraform (stato con dati sensibili, cache provider)
.terraform/
*.tfstate
*.tfstate.*
terraform.tfvars
*.tfplan

# Supabase CLI (cache locale, non versionare)
supabase/.temp/
# HOME e CLI isolate usate dallo script frontend/ios/App/supabase-local.
# .supabase-home è dove la CLI scrive i token di `supabase login`: mai versionarla.
frontend/ios/App/.supabase-home/
frontend/ios/App/.supabase-cli-local/
frontend/ios/App/.npm-cache/

# Snapshot e log del browser MCP (artefatti di debug usa-e-getta)
.playwright-mcp/

# Editor / OS
.DS_Store
.vscode/
.idea/
# Artefatti "mark of the web" di WSL/Windows
*:Zone.Identifier

# Script e2e e SQL usa-e-getta (convenzione: prefisso tmp-, da rimuovere dopo l'uso)
scripts/tmp-*
