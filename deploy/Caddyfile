# Caddyfile — reverse proxy con HTTPS automatico (Let's Encrypt).
#
# Senza dominio proprio si usa sslip.io: l'hostname <IP-con-trattini>.sslip.io
# risolve al tuo IP, ma essendo un nome Caddy ottiene un certificato valido.
# Sostituisci l'IP qui sotto con quello (Elastic IP) della tua istanza:
#   52.30.1.2  ->  52-30-1-2.sslip.io
# Con un dominio vero, basta rimpiazzare l'hostname con app.tuodominio.com.
#
# In produzione il DB è Supabase Cloud: il browser lo raggiunge direttamente sul
# dominio *.supabase.co, quindi qui NON serve alcun vhost per Supabase.

52-30-1-2.sslip.io {
    encode zstd gzip

    # Le chiamate /api/* vanno al backend Fastify
    handle /api/* {
        reverse_proxy 127.0.0.1:3000
    }

    # Tutto il resto: SPA Vue (build in dist/), con fallback su index.html
    handle {
        root * /opt/gym/frontend/dist
        try_files {path} /index.html
        file_server
    }
}
