# Timer: backup giornaliero alle 03:00. Copia in /etc/systemd/system/, poi:
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now gym-backup.timer
#   systemctl list-timers gym-backup.timer   # verifica prossima esecuzione
[Unit]
Description=Backup giornaliero DB Gym Manager

[Timer]
OnCalendar=*-*-* 03:00:00
Persistent=true

[Install]
WantedBy=timers.target
