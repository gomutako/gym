# Frontend — build di PRODUZIONE.
#
# ⚠️ Questo file è VERSIONATO di proposito (eccezione in .gitignore), perché non
# contiene segreti: entrambi i valori finiscono nel bundle JavaScript servito a
# chiunque visiti il sito. La chiave è di tipo "publishable" — ciò che protegge i
# dati è la Row Level Security del database, non la sua riservatezza.
# La chiave `secret`/`service_role` NON deve mai comparire qui.
#
# Averlo nel repo elimina un passaggio di configurazione che fallisce in
# silenzio: senza queste variabili la build riesce, ma l'app si apre bianca
# perché initRuntimeConfig() non trova la configurazione. Serve anche alla build
# dell'app iOS, che parte da qui.
VITE_SUPABASE_URL=https://nayiujdfvevccoluqwic.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_tIetTMCODo7GgeKcDYDRXg_1bTkC5gI

# Coppia usata SOLO dal simulatore iOS (rilevato a runtime via @capacitor/device
# → isVirtual): lì si sviluppa contro il Supabase locale. Sul device fisico e sul
# web vale la coppia sopra. I valori si leggono con `npm run db:status` e sono
# specifici della macchina, quindi restano dei segnaposto qui.
# VITE_SUPABASE_URL_SIM=http://127.0.0.1:54321
# VITE_SUPABASE_ANON_KEY_SIM=<publishable key locale da db:status>
