# Frontend — build di PRODUZIONE. Copiare in frontend/.env.production
# In produzione si punta a Supabase CLOUD: URL e anon key dal
# Supabase Dashboard → Project Settings → API.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=<anon public key dal dashboard>
# Host dell'app: Caddy fa reverse proxy di /api/* sul backend Fastify.
# Senza dominio proprio: https://<IP-con-trattini>.sslip.io
VITE_API_BASE_URL=https://52-30-1-2.sslip.io

# Terna usata SOLO dal simulatore iOS (rilevato via @capacitor/device →
# isVirtual). La build dell'app iOS parte da questo file, ma nel simulatore si
# sviluppa contro Supabase e backend locali; sul device fisico vale la terna
# sopra. Valori da `npm run db:status`. Se queste righe mancano, anche il
# simulatore usa la configurazione cloud.
VITE_SUPABASE_URL_SIM=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY_SIM=<anon key locale da `npm run db:status`>
VITE_API_BASE_URL_SIM=http://localhost:3000
