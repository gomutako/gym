# Frontend — build di PRODUZIONE. Copiare in frontend/.env.production
#
# L'app parla SOLO con Supabase: non esiste più un backend da configurare.
# URL e anon key dal Supabase Dashboard → Project Settings → API.
# La anon key è pubblica per costruzione (finisce nel bundle): ciò che protegge
# i dati è la Row Level Security, non la segretezza di questa chiave.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=<anon public key dal dashboard>

# Coppia usata SOLO dal simulatore iOS (rilevato a runtime via
# @capacitor/device → isVirtual). La build dell'app iOS parte da questo file, ma
# nel simulatore si sviluppa contro il Supabase locale; sul device fisico vale la
# coppia sopra. Valori da `npm run db:status`.
# Se queste righe mancano, anche il simulatore usa la configurazione cloud.
VITE_SUPABASE_URL_SIM=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY_SIM=<anon key locale da `npm run db:status`>
